<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$this->htmlElement('body')->appendAttribute('class', 'item resource browse');

$filterLocale = (bool) $this->siteSetting('filter_locale_values');
$lang = $this->lang();
$valueLang = $filterLocale ? [$lang, ''] : null;

$query = $this->params()->fromQuery();
$itemSetShow = isset($itemSet);
if ($itemSetShow):
    $this->htmlElement('body')->appendAttribute('class', 'item-set');
    $query['item_set_id'] = $itemSet->id();
endif;

$headingTerm = $this->siteSetting('browse_heading_property_term');
$bodyTerm = $this->siteSetting('browse_body_property_term');
$bodyTruncate = $this->themeSetting('truncate_body_property');
$bodyTruncate = in_array($bodyTruncate, ['fadeout', 'ellipsis', 'full'], true) ? $bodyTruncate : '';

$sortHeadings = [
    [
        'label' => $translate('Title'),
        'value' => 'dcterms:title'
    ],
    [
        'label' => $translate('Identifier'),
        'value' => 'dcterms:identifier'
    ],
    [
        'label' => $translate('Record Type'),
        'value' => 'ija:record_type'
    ],
    [
        'label' => $translate('Date'),
        'value' => 'dcterms:date'
    ],
    [
        'label' => $translate('Language'),
        'value' => 'dcterms:language'
    ],
];

?>
<!-- view/omeka/site/item/browse.phtml -->

<?php echo $this->searchFilters(); ?>

<div class="browse-toolbar">
  <div class="browse-toolbar-summary">
    <?php echo $this->pagination(); ?>
    <?php echo $this->hyperlink($translate('Advanced search'), $this->url('site/resource', ['controller' => 'item', 'action' => 'search'], ['query' => $query], true), ['class' => 'advanced-search']); ?>
  </div>
  <?php echo $this->browse()->renderSortSelector(array_column($sortHeadings, 'label', 'value')); ?>
</div>

<?php $this->trigger('view.browse.before'); ?>

<div class="row mb-2">
  <?php foreach ($items as $item):?>
    <?php
      $heading = $headingTerm ? $item->value($headingTerm, ['default' => $translate('[Untitled]'), 'lang' => $valueLang]) : $item->displayTitle(null, $valueLang);
      $body = $bodyTerm ? $item->value($bodyTerm, ['lang' => $valueLang]) : $item->displayDescription(null, $valueLang);
      $recordType = $item->value('ija:record_type');
    ?>
    <div class="col-md-6">
      <div class="card browse-card g-0 border rounded overflow-hidden flex-row flex-nowrap mb-4 shadow-sm h-md-250 position-relative">
        <div class="col browse-card-body p-3 p-lg-4 d-flex flex-column position-static">
          <strong class="d-inline-block mb-2 text-primary">
            <?php echo $this->partial('common/record-type-icon', ['recordType' => $recordType]); ?>
            <?php echo $escape($recordType); ?>
          </strong>
          <h3 class="mb-0" dir="auto"><?php echo $escape($heading); ?></h3>
          <div class="mb-1 text-muted">
            <?php if($item->value('dcterms:date')): ?>
              Date: <?php echo $escape($item->value('dcterms:date')); ?>
            <?php endif; ?>
            <?php if($item->value('ija:ija_number')): ?>
              <?php if($item->value('dcterms:date')): ?>
                &middot;
              <?php endif; ?>
              IJA Number: <?php echo $escape($item->value('ija:ija_number')); ?>
            <?php endif; ?>
            <?php if($item->value('dcterms:language')): ?>
              &middot;
              Language: <?php echo $escape($item->value('dcterms:language')); ?>
            <?php endif; ?>
          </div>
          <div class="card-text mb-auto">
            <?php if($body): ?>
              <div dir="auto" class="description <?php echo ($bodyTruncate) ? $bodyTruncate : ''; ?>">
                <?php echo nl2br($escape($body)); ?>
              </div>
            <?php endif; ?>
          </div>
          <?php echo $item->link($translate('View Item'), null, ['class' => 'stretched-link']); ?>
        </div>
        <?php if ($thumbnail = $this->thumbnail($item, 'medium', ['loading' => 'lazy', 'decoding' => 'async'])): ?>
        <div class="col-auto browse-thumbnail">
          <?php echo $item->linkRaw($thumbnail, null, ['class' => 'd-block']); ?>
        </div>
        <?php endif; ?>
      </div>
    </div>

  <?php endforeach; ?>

  <?php echo $this->pagination(); ?>

</div>

<?php $this->trigger('view.browse.after'); ?>
