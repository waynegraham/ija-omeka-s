<?php
$translate = $this->plugin('translate');
$this->htmlElement('body')->appendAttribute('class', 'item resource show');
$embedMedia = $this->siteSetting('item_media_embed', false);
$itemMedia = $item->media();
require_once dirname(__DIR__, 4) . '/src/ItemFiles.php';
$files = \IjaTheme\ItemFiles::describe($itemMedia);
$valueLang = $this->siteSetting('filter_locale_values') ? [$this->lang(), ''] : null;
$recordTitle = $item->displayTitle(null, $valueLang);
$recordUrl = $item->url(null, true);
$number = $item->value('ija:ija_number');
$isVideo = (string) $item->value('ija:record_type') === 'Video';

?>
<?php $this->trigger('view.show.before'); ?>

<a class="item-back-results" hidden><?php echo $this->escapeHtml($translate('Back to results')); ?></a>
<div class="row title-bar auto item-record-header">
  <div class="col-auto item-title-icon">
    <?php echo $this->partial('common/record-type-icon', ['recordType' => $item->value('ija:record_type'), 'large' => true]); ?>
  </div>
  <div class="col item-title-text">
    <?php if($item->value('ija:ija_number')): ?>
    <span class="small text-muted">IJA Number: <?php echo $this->escapeHtml($item->value('ija:ija_number')); ?></span>
    <?php endif; ?>
    <div class="item-primary-title" dir="auto"><?php echo $this->pageTitle($recordTitle, 1); ?></div>
    <?php if($item->value('dcterms:alternative')): ?>
      <p class="transliteration item-subtitle" dir="auto"><?php echo $this->escapeHtml($item->value('dcterms:alternative')); ?></p>
    <?php endif; ?>
    <p class="item-key-facts"><?php echo $this->escapeHtml($item->value('ija:record_type')); ?></p>
  </div>

</div>
<nav class="item-section-links" aria-label="<?php echo $this->escapeHtml($translate('On this record')); ?>">
  <a href="#item-viewer"><?php echo $this->escapeHtml($translate('View item')); ?></a>
  <a href="#item-tools"><?php echo $this->escapeHtml($translate('Files and citation')); ?></a>
  <a href="#ija_metadata"><?php echo $this->escapeHtml($translate('Catalogue details')); ?></a>
</nav>

<section id="item-viewer" class="item-preview" aria-label="<?php echo $this->escapeHtmlAttr($translate('Item preview')); ?>">
    <?php if ($isVideo): ?>
      <h2><?php echo $translate('View'); ?></h2>
      <?php foreach ($itemMedia as $media): ?>
        <div class="ratio ratio-16x9">
          <?php echo $media->render(['width' => '100%', 'height' => '100%']); ?>
        </div>
      <?php endforeach; ?>
    <?php else: ?>
      <h2><?php echo $translate('View item'); ?></h2>
      <?php if ($files['images']): ?><p class="item-media-summary"><?php echo $this->escapeHtml(sprintf($translate(count($files['images']) === 1 ? '%s image' : '%s images'), count($files['images']))); ?><?php if ($files['pdfs']) echo ' · ' . $this->escapeHtml(sprintf($translate(count($files['pdfs']) === 1 ? '%s PDF' : '%s PDFs'), count($files['pdfs']))); ?></p><?php endif; ?>
      <?php
      // Preserve viewer-module output and placement; provide an honest empty state
      // only when no provider rendered anything into this hook.
      ob_start();
      try {
          $this->trigger('view.show.after');
      } finally {
          $previewContent = ob_get_clean();
      }
      echo $previewContent;
      ?>
      <?php if (trim($previewContent) === '' && !$embedMedia): ?>
      <p><?php echo $this->escapeHtml($translate('No inline preview is available. Original files and catalogue details are provided below.')); ?></p>
      <?php endif; ?>
    <?php endif; ?>
    <?php if ($embedMedia && $itemMedia && !$isVideo): ?>
    <div class="media-embeds"><?php foreach ($itemMedia as $media) echo $media->render(); ?></div>
    <?php endif; ?>
</section>

<?php echo $this->partial('common/item-tools', [
    'files' => $files, 'title' => $recordTitle, 'number' => $number, 'recordUrl' => $recordUrl,
    'siteTitle' => isset($site) ? $site->title() : $translate('Iraqi Jewish Archive'),
]); ?>

<section id="ija_metadata" aria-label="<?php echo $this->escapeHtml($translate('Item details')); ?>">
  <h2><?php echo $this->escapeHtml($translate('Item details')); ?></h2>
  <?php echo $item->displayValues(['viewName' => 'common/item-metadata']); ?>
</section>

<?php
   $subjectValues = $item->displaySubjectValues([
       'page' => $this->params()->fromQuery('page', 1),
       'perPage' => 25,
       'resourceProperty' => $this->params()->fromQuery('resource_property'),
   ]);
?>
<?php if ($subjectValues): ?>
<div id="item-linked">
   <h2><?php echo $translate('Linked resources'); ?></h2>
   <?php echo $subjectValues; ?>
</div>
<?php endif; ?>
