<?php
$this->headLink()->appendStylesheet($this->assetUrl('css/page-blocks.css', 'Omeka'));
$this->htmlElement('body')->appendAttribute('class', $pageBodyClass);
$this->pageTitle($page->title(), 2);
$isHome = $page->slug() === 'home';
$designedHome = $isHome && (bool) $this->themeSetting('home_layout', true);
if ($isHome) $this->htmlElement('body')->appendAttribute('class', 'site-home');
$showPagePagination = $this->siteSetting('show_page_pagination', true);
$recovery = null;
if ($page->slug() === 'recovery-artifacts' && $this->themeSetting('recovery_story_layout', true)) {
    require_once dirname(__DIR__, 4) . '/src/RecoveryExhibit.php';
    $recovery = \IjaTheme\RecoveryExhibit::prepare((string) $this->content);
}

$nav = $site->publicNav();
$container = $nav->getContainer();
$activePage = $nav->findActive($container);
switch ($this->siteSetting('subnav_display')) {
    case 'show':
        $displaySubnav = $this->displayNavigation;
        break;
    case 'hide':
        $displaySubnav = false;
        break;
    default:
        $displaySubnav = $this->displayNavigation && $activePage && $activePage['page']->hasPages();
}
?>
<?php if ($designedHome): ?>
  <?php $this->trigger('view.show.before'); ?>
  <?php echo $this->partial('common/home', ['site' => $site]); ?>
  <?php $this->trigger('view.show.after'); ?>
<?php else: ?>
<?php if ($activePage): ?>
    <?php if ($activePage['depth'] !== 0): ?>
    <nav class="breadcrumbs" aria-label="<?php echo $this->escapeHtmlAttr($this->translate('Breadcrumb')); ?>"><?php echo $nav->breadcrumbs()->setPartial('common/bootstrap-breadcrumbs'); ?></nav>
    <?php endif; ?>
<?php endif; ?>
<div class="page-layout<?php if ($recovery || ($activePage && $displaySubnav)) echo ' exhibit-page'; ?>">
  <?php if ($recovery): ?>
  <header class="exhibit-introduction">
    <h1><?php echo $this->escapeHtml($page->title()); ?></h1>
    <p><?php echo $this->escapeHtml($this->translate('How waterlogged books and documents were recovered, stabilized and prepared for preservation.')); ?></p>
  </header>
  <?php endif; ?>
  <div class="row">
      <?php if ($activePage && $displaySubnav): ?>
        <aside class="col-12 col-md-3 pt-3 light-bg page-nav">
          <details class="exhibit-chapters" open>
            <summary><?php echo $this->escapeHtml($this->translate('In this exhibit')); ?></summary>
            <nav class="sub-menu" aria-label="<?php echo $this->escapeHtml($this->translate('Exhibit chapters')); ?>"><?php echo $nav->menu()->renderSubMenu(); ?></nav>
          </details>
        </aside>
      <?php endif; ?>

    <div class="col-12 col-md site-page-content">
      <?php $this->trigger('view.show.before'); ?>
      <?php if ($isHome) echo $this->partial('common/home-actions'); ?>
      <div class="blocks mt-3<?php if (!$isHome) echo ' ps-2'; ?>">
          <?php echo $recovery ? $this->partial('common/exhibit/recovery', ['recovery' => $recovery]) : $this->content; ?>
      </div>
      <?php $this->trigger('view.show.after'); ?>
      <?php if ($showPagePagination): ?>
      <?php echo $this->sitePagePagination(); ?>
      <?php endif; ?>
    </div>
  </div>
</div>

<?php endif; ?>
