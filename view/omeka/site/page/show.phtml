<?php
$this->headLink()->appendStylesheet($this->assetUrl('css/page-blocks.css', 'Omeka'));
$this->htmlElement('body')->appendAttribute('class', $pageBodyClass);
$this->pageTitle($page->title(), 2);
$isHome = $page->slug() === 'home';
if ($isHome) $this->htmlElement('body')->appendAttribute('class', 'site-home');
$showPagePagination = $this->siteSetting('show_page_pagination', true);

$nav = $site->publicNav();
$container = $nav->getContainer();
$activePage = $nav->findActive($container);
switch ($this->siteSetting('subnav_display')) {
    case 'show':
        $displaySubnav = $this->displayNavigation;
        break;
    case 'hide':
        $displaySubnav = false;
        break;
    default:
        $displaySubnav = $this->displayNavigation && $activePage && $activePage['page']->hasPages();
}
?>
<?php if ($activePage): ?>
    <?php if ($activePage['depth'] !== 0): ?>
    <nav class="breadcrumbs" aria-label="<?php echo $this->escapeHtmlAttr($this->translate('Breadcrumb')); ?>"><?php echo $nav->breadcrumbs()->setPartial('common/bootstrap-breadcrumbs'); ?></nav>
    <?php endif; ?>
<?php endif; ?>
<div class="container">
  <div class="row">
      <?php if ($activePage && $displaySubnav): ?>
        <aside class="col-12 col-md-3 pt-3 light-bg page-nav">
          <nav class="sub-menu"><?php echo $nav->menu()->renderSubMenu(); ?></nav>
        </aside>
      <?php endif; ?>

    <div class="col-12 col-md site-page-content">
      <?php $this->trigger('view.show.before'); ?>
      <?php if ($isHome) echo $this->partial('common/home-actions'); ?>
      <div class="blocks mt-3<?php if (!$isHome) echo ' ps-2'; ?>">
          <?php echo $this->content; ?>
      </div>
      <?php $this->trigger('view.show.after'); ?>
      <?php if ($showPagePagination): ?>
      <?php echo $this->sitePagePagination(); ?>
      <?php endif; ?>
    </div>
  </div>
</div>
