<?php
// @see https://github.com/fabiopaiva/zf2-navigation-bootstrap3
// Updated for Bootstrap 5
/* @var $container Laminas\Navigation\Navigation */
$container = $this->container;
$ulClass= 'navbar-nav me-auto mb-2 mb-md-0';
?>
<!-- view/common/bootstrap-navigation.phtml -->
<ul class="<?php echo $ulClass; ?>">
    <?php foreach ($container as $page): ?>
        <?php if (!$this->navigation()->accept($page)) continue; ?>
        <?php /* @var $page Laminas\Navigation\Page\Mvc */ ?>
        <?php $hasChildren = $page->hasPages() ?>
        <?php if (!$hasChildren): ?>
            <li class="nav-item">
                <a
                    class="nav-link<?php if ($page->isActive()) echo ' active' ?>"
                    <?php if ($page->isActive()) echo 'aria-current="page"'; ?>
                    href="<?php echo $this->escapeHtmlAttr($page->getHref()) ?>"
                    <?php if ($page->getTarget() != ""): ?>
                        target="<?php echo $this->escapeHtmlAttr($page->getTarget()); ?>" rel="noopener"
                    <?php endif; ?>
                    >
                    <?php echo $this->escapeHtml($this->translate($page->getLabel(), $this->navigation($container)->getTranslatorTextDomain())); ?>
                </a>
            </li>
        <?php else: ?>
            <?php
            //check if access is allowed at least one item
            $access = false;
            foreach ($page->getPages() as $child) {
                if ($this->navigation()->accept($child) && $child->get("separator") !== true) {
                    $access = true;
                }
            }
            if ($access) :
                $dropdownId = uniqid("ija-menu-");
                ?>
                <li class="nav-item dropdown<?php if ($page->isActive(true)) echo ' active' ?>">
                    <button type="button" id="<?php echo $dropdownId; ?>" class="nav-link dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" aria-controls="<?php echo $dropdownId; ?>-items">
                        <?php echo $this->escapeHtml($this->translate($page->getLabel(),$this->navigation($container)->getTranslatorTextDomain())); ?>
                    </button>
                    <ul id="<?php echo $dropdownId; ?>-items" class="dropdown-menu" aria-labelledby="<?php echo $dropdownId; ?>">
                        <?php foreach ($page->getPages() as $child): ?>
                            <?php if (!$this->navigation()->accept($child)) continue; ?>
                            <?php if ($child->get("separator") === true): ?>
                                <li><hr class="dropdown-divider"></li>
                                    <?php
                                    continue;
                                endif;
                                ?>
                            <li<?php if ($child->isActive()) echo ' class="active"' ?>>
                                <a class="dropdown-item"
                                    <?php if ($child->isActive()) echo 'aria-current="page"'; ?>
                                    href="<?php echo $this->escapeHtmlAttr($child->getHref()) ?>"
                                    <?php if ($child->getTarget() != ""): ?>
                                        target="<?php echo $this->escapeHtmlAttr($child->getTarget()); ?>" rel="noopener"
                                    <?php endif; ?> >
                                        <?php if ($child->get("icon")): ?>
                                        <span class="<?php echo $this->escapeHtmlAttr($child->get("icon")); ?>"></span>
                                    <?php endif; ?>
                                    <?php echo $this->escapeHtml($this->translate($child->getLabel(),$this->navigation($container)->getTranslatorTextDomain())); ?>
                                </a>
                            </li>
                        <?php endforeach ?>
                    </ul>
                </li>
            <?php endif; ?>
        <?php endif ?>
    <?php endforeach ?>
</ul>

<?php echo $this->partial('common/search-form'); ?>
