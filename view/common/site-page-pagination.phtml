<?php $translate = $this->plugin('translate'); ?>
<?php if ($prevPage || $nextPage): ?>
<nav class="site-page-pagination" aria-label="<?php echo $this->escapeHtml($translate('Page navigation')); ?>">
    <?php echo $prevPage ? $this->hyperlink(sprintf($translate('Previous: %s'), $prevPage->title()), $prevPage->siteUrl(), ['class' => 'exhibit-previous', 'rel' => 'prev']) : ''; ?>
    <?php echo $nextPage ? $this->hyperlink(sprintf($translate('Next: %s'), $nextPage->title()), $nextPage->siteUrl(), ['class' => 'exhibit-next', 'rel' => 'next']) : ''; ?>
</nav>
<?php endif; ?>
