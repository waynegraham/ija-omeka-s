      <h1 id="home-title" dir="auto"><?php echo $escape($this->themeSetting('home_heading', $translate('Explore the Iraqi Jewish Archive'))); ?></h1>
      <p class="archive-hero-description" dir="auto"><?php echo $escape($this->themeSetting('home_intro', $translate('Discover books, documents and photographs that illuminate Jewish life in Iraq.'))); ?></p>
      <form id="home-search" action="<?php echo $this->escapeHtmlAttr($searchAction); ?>" method="get" role="search" aria-label="<?php echo $this->escapeHtmlAttr($translate('Search the collection')); ?>">
