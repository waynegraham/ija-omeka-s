<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$ids = [];
foreach (preg_split('/[\s,]+/', (string) $this->themeSetting('home_featured_items', '17159,1022,284,269'), -1, PREG_SPLIT_NO_EMPTY) as $id) {
    if (ctype_digit($id) && (int) $id > 0) $ids[] = (int) $id;
}
$ids = array_slice(array_values(array_unique($ids)), 0, 4);
$featured = [];
if ($ids) {
    // One public, site-scoped request; never substitute unrelated records.
    $resources = $this->api()->search('items', ['id' => $ids, 'site_id' => $site->id(), 'is_public' => true, 'limit' => 4], ['countQuery' => false])->getContent();
    $byId = [];
    foreach ($resources as $resource) $byId[$resource->id()] = $resource;
    foreach ($ids as $id) if (isset($byId[$id])) $featured[] = $byId[$id];
}
$valueLang = $this->siteSetting('filter_locale_values') ? [$this->lang(), ''] : null;
$imageUrl = $this->themeSettingAssetUrl('home_image') ?: $this->assetUrl('images/siegfreid-wolff-letter-lg.jpg');
$searchAction = $this->siteSetting('search_type', 'sitewide') === 'cross-site'
    ? $this->url('site/cross-site-search', ['action' => 'results'], true)
    : $this->url('site/resource', ['controller' => 'index', 'action' => 'search'], true);
?>
<div class="archive-home">
  <section class="archive-hero" aria-labelledby="home-title">
