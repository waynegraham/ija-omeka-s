      <figcaption><?php echo $escape($this->themeSetting('home_image_caption', $translate('Handwritten letter from the Iraqi Jewish Archive'))); ?></figcaption>
    </figure>
  </section>
  <?php echo $this->partial('common/home-highlights', ['items' => $featured, 'valueLang' => $valueLang]); ?>
  <section class="archive-stories archive-section" aria-label="<?php echo $this->escapeHtmlAttr($translate('Explore the stories')); ?>">
    <article>
      <img class="archive-story-image" src="<?php echo $this->escapeHtmlAttr($this->assetUrl('images/boating-on-tigris.jpg')); ?>" alt="<?php echo $this->escapeHtmlAttr($translate('Boating on the Tigris')); ?>" loading="lazy" width="105" height="150">
      <h2><?php echo $escape($translate('Jewish life in Iraq')); ?></h2>
      <p><?php echo $escape($translate('Explore the history and heritage of a community with roots stretching back more than 2,500 years.')); ?></p>
