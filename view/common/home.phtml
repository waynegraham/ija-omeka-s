        <div class="input-group">
          <input id="home-search-query" class="form-control" name="fulltext_search" type="search" placeholder="<?php echo $this->escapeHtmlAttr($translate('Enter a word or phrase')); ?>">
          <button class="btn btn-light" type="submit"><?php echo $escape($translate('Search')); ?></button>
        </div>
      </form>
      <nav class="archive-hero-links" aria-label="<?php echo $this->escapeHtmlAttr($translate('Explore the archive')); ?>">
        <?php echo $this->hyperlink($translate('Browse the collection'), $this->url('site/resource', ['controller' => 'item', 'action' => 'browse'], true)); ?>
        <?php echo $this->hyperlink($translate('Advanced search'), $this->url('site/resource', ['controller' => 'item', 'action' => 'search'], true)); ?>
      </nav>
