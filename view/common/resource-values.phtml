<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$labelInfo = $this->fallbackSetting('property_label_information', ['site', 'global'], 'none');

if ($this->status()->isSiteRequest()) {
  $showLocale = (bool) $this->siteSetting('show_locale_label', true);
  $filterLocale = $this->siteSetting('filter_locale_values');
  $lang = (string) $this->lang();
  $showValueAnnotations = $this->siteSetting('show_value_annotations', '');
} else {
  $showLocale = true;
  $filterLocale = false;
  $lang = null;
  $showValueAnnotations = true;
}
?>
<!-- view/common/resource-values.phtml -->

<dl class="row dl-invert mt-5">
  <?php foreach ($values as $term => $propertyData): ?>
    <?php
    $visibleValues = array_filter($propertyData['values'], static function ($value) use ($filterLocale, $lang) {
        $valueLang = (string) $value->lang();
        return !$filterLocale || $valueLang === '' || strcasecmp($valueLang, (string) $lang) === 0;
    });
    if (!$visibleValues) continue;
    ?>
    <dt class="col-sm-4 term">
    <?php if (!empty($propertyData['alternate_label'])): ?>
        <?php echo $escape($propertyData['alternate_label']); ?>
        <?php else: ?>
        <?php echo $escape($translate($propertyData['property']->label())); ?>
        <?php endif; ?>
        <?php if ('term' === $labelInfo): ?>
        <span class="field-term">(<?php echo $escape($propertyData['property']->term()); ?>)</span>
        <?php elseif ('vocab' === $labelInfo): ?>
        <span class="field-term">(<?php echo $escape($propertyData['property']->vocabulary()->label()); ?>)</span>
        <?php endif; ?> 
    </dt>
    <dd class="col-sm-8">
    <?php foreach ($visibleValues as $value): ?>
            <?php
            $valueType = $value->type();
            $valueLang = (string) $value->lang();
            $valueAnnotation = $value->valueAnnotation();
            $class = ['value'];
            if ('resource' == $valueType || strpos($valueType, 'resource') !== false) {
                $class[] = 'resource';
                if ($resource = $value->valueResource()) {
                    $class[] = $escape($resource->resourceName());
                }
            } elseif ('uri' == $valueType) {
                $class[] = 'uri';
            }
            ?>
            <div class="<?php echo implode(' ', $class); ?>" lang="<?php echo $escape($valueLang); ?>">
                <?php if ($showLocale && $valueLang): ?>
                <span class="language"><?php echo $escape($valueLang); ?></span>
                <?php endif; ?>
                <span class="value-content" dir="auto"><?php echo $filterLocale ? $value->asHtml($lang) : $value->asHtml(); ?></span>
                <?php if(!$value->isPublic()): ?>
                    <span role="img" title="<?php echo $escape($translate('Private')); ?>" aria-label="<?php echo $escape($translate('Private')); ?>"><?php echo $this->partial('common/icon', ['icon' => 'private']); ?></span>
                <?php endif; ?>
                <?php if ($valueAnnotation && $showValueAnnotations): ?>
                    <details class="value-annotation"<?php if ($showValueAnnotations === 'expanded') echo ' open'; ?>>
                        <summary>
                            <span class="has-annotation"><?php echo $this->partial('common/icon', ['icon' => 'annotation']); ?></span>
                            <?php echo $escape($translate('Value annotation')); ?>
                        </summary>
                        <div class="annotation"><?php echo $valueAnnotation->displayValues(); ?></div>
                    </details>
                <?php endif; ?>
                <?php $this->trigger('view.show.value', ['value' => $value]); ?>
            </div>
        <?php endforeach; ?>
    </dd>
  <?php endforeach; ?>
</dl>
