<?php
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
?>
<form class="sorting" action="" method="get">
  <?php echo $this->queryToHiddenInputs(['sort_by', 'sort_order', 'sort_by_default', 'sort_order_default']); ?>
  <div class="sort-controls">
    <label class="sort-field">
      <span><?php echo $escape($translate('Sort by')); ?></span>
      <select class="form-select" name="sort_by" aria-label="<?php echo $escape($translate('Sort by')); ?>">
        <?php foreach ($sortConfig as $sortBy => $label): ?>
        <option value="<?php echo $escape($sortBy); ?>" <?php echo ($sortByQuery === $sortBy) ? 'selected' : ''; ?>><?php echo $escape($label); ?></option>
        <?php endforeach; ?>
      </select>
    </label>
    <label class="sort-field">
      <span><?php echo $escape($translate('Sort order')); ?></span>
      <select class="form-select" name="sort_order" aria-label="<?php echo $escape($translate('Sort order')); ?>">
        <option value="asc" <?php echo ($sortOrderQuery === 'asc') ? 'selected' : ''; ?>><?php echo $escape($translate('Ascending')); ?></option>
        <option value="desc" <?php echo ($sortOrderQuery === 'desc') ? 'selected' : ''; ?>><?php echo $escape($translate('Descending')); ?></option>
      </select>
    </label>
    <button class="btn btn-primary" type="submit"><?php echo $escape($translate('Sort')); ?></button>
  </div>
</form>
